{
  "name": "splayer",
  "productName": "SPlayer",
  "desktopName": "top.imsyy.SPlayer",
  "version": "3.1.1",
  "packageManager": "pnpm@12.18.0",
  "description": "A minimalist music player",
  "main": "./out/main/index.js",
  "author": "imsyy",
  "github": "https://github.com/MoYingJi/SPlayer",
  "repository": "github:MoYingJi/SPlayer",
  "license": "AGPL-3.0-only",
  "license-file": "LICENSE",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "vendors:setup": "tsx scripts/vendors.ts install",
    "vendors:build": "tsx scripts/vendors.ts build",
    "build:native": "tsx scripts/build-native.ts",
    "start": "electron-vite preview",
    "dev": "pnpm vendors:build && pnpm build:native --dev && tsx scripts/dev.ts",
    "build": "rimraf dist && pnpm vendors:build && pnpm build:native && pnpm typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:web": "pnpm build",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:pack": "pnpm build && electron-builder --config electron-builder.config.ts",
    "build:win": "pnpm build:pack --win",
    "build:mac": "pnpm build:pack --mac",
    "build:linux": "pnpm build:pack --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@neteasecloudmusicapienhanced/api": "^4.41.1",
    "axios": "^1.21.1",
    "axios-retry": "^4.5.0",
    "better-sqlite3": "^13.1.1",
    "change-case": "^5.4.4",
    "electron-store": "^12.0.0",
    "file-saver": "^2.0.5",
    "font-list": "^2.1.0",
    "fuse.js": "^7.5.0",
    "get-port": "^7.2.0",
    "music-metadata": "^12.5.0",
    "p-limit": "^7.3.3",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@applemusic-like-lyrics/core": "link:vendor/applemusic-like-lyrics/packages/core",
    "@applemusic-like-lyrics/lyric": "link:vendor/applemusic-like-lyrics/packages/lyric",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@fastify/cookie": "^11.1.5",
    "@fastify/http-proxy": "^11.6.6",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.10",
    "@material/material-color-utilities": "^0.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/emscripten": "^1.41.6",
    "@types/file-saver": "^2.0.7",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/md5": "^2.3.6",
    "@types/node": "^24.19.2",
    "@types/sortablejs": "^1.15.9",
    "@types/ws": "^8.18.2",
    "@videojs/html": "^10.4.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/devtools-api": "^8.2.1",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "ajv": "^8.20.0",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.10",
    "electron": "^44.11.3",
    "electron-builder": "27.0.0-alpha.8",
    "electron-log": "^5.4.4",
    "electron-vite": "6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "fast-glob": "^3.3.3",
    "fastify": "^5.12.8",
    "github-markdown-css": "^5.9.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "js-cookie": "^3.0.8",
    "localforage": "^1.10.0",
    "lodash-es": "^4.18.1",
    "md5": "^2.3.0",
    "naive-ui": "~2.45.3",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "sass": "^1.108.2",
    "sortablejs": "^1.15.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.8",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0",
    "vue-tsc": "^3.3.14"
  }
}
