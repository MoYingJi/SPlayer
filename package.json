{
  "name": "splayer",
  "productName": "SPlayer",
  "desktopName": "top.imsyy.SPlayer",
  "version": "3.1.1",
  "packageManager": "pnpm@11.15.1",
  "description": "A minimalist music player",
  "main": "./out/main/index.js",
  "author": "imsyy",
  "home": "https://imsyy.top",
  "github": "https://github.com/SPlayer-Dev/SPlayer",
  "blog": "https://blog.imsyy.top",
  "repository": "github:SPlayer-Dev/SPlayer",
  "license": "AGPL-3.0",
  "license-file": "LICENSE",
  "engines": {
    "node": ">=24",
    "npm": ">=11",
    "pnpm": ">=11"
  },
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "build:native": "tsx scripts/build-native.ts",
    "start": "electron-vite preview",
    "dev": "pnpm build:native -- --dev && tsx scripts/dev.ts",
    "build": "rimraf dist && pnpm build:native && pnpm typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:web": "pnpm build",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:win": "pnpm build && electron-builder --config electron-builder.config.ts --win",
    "build:mac": "pnpm build && electron-builder --config electron-builder.config.ts --mac",
    "build:linux": "pnpm build && electron-builder --config electron-builder.config.ts --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@neteasecloudmusicapienhanced/api": "^4.37.0",
    "axios": "^1.18.1",
    "axios-retry": "^4.5.0",
    "better-sqlite3": "^13.0.1",
    "change-case": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "file-saver": "^2.0.5",
    "font-list": "^2.1.0",
    "fuse.js": "^7.5.0",
    "get-port": "^7.2.0",
    "music-metadata": "^11.14.0",
    "p-limit": "^7.3.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@applemusic-like-lyrics/core": "^0.5.2",
    "@applemusic-like-lyrics/lyric": "^1.0.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@fastify/cookie": "^11.1.2",
    "@fastify/http-proxy": "^11.6.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^9.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/emscripten": "^1.41.5",
    "@types/file-saver": "^2.0.7",
    "@types/js-cookie": "^3.0.6",
    "@types/md5": "^2.3.6",
    "@types/node": "^24.13.3",
    "@types/sortablejs": "^1.15.9",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vueuse/core": "^14.3.0",
    "@vueuse/integrations": "^14.3.0",
    "ajv": "^8.20.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "electron": "^43.1.1",
    "electron-builder": "27.0.0-alpha.5",
    "electron-log": "^5.4.4",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "fast-glob": "^3.3.3",
    "fastify": "^5.10.0",
    "github-markdown-css": "^5.9.0",
    "globals": "^16.4.0",
    "js-cookie": "^3.0.8",
    "localforage": "^1.10.0",
    "lodash-es": "^4.18.1",
    "marked": "^16.4.2",
    "md5": "^2.3.0",
    "naive-ui": "2.43.2",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "plyr": "^3.8.4",
    "prettier": "^3.9.5",
    "rimraf": "^6.1.3",
    "sass": "^1.101.0",
    "sortablejs": "^1.15.7",
    "terser": "^5.49.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.6",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vite-plugin-wasm": "^3.6.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.7"
  }
}
